# LLM API 配置（必填）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2-6

# 图片生成后端（可选，默认 pollinations 免费）
# 可选值: pollinations / siliconflow / dalle
IMAGE_PROVIDER=pollinations
# IMAGE_API_KEY=your_openai_api_key_here  # DALL-E 需要
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here  # SiliconFlow 免费额度，可选
# 封面是否走 AI 绘画。默认 false（模板大字封面 CTR 更高）；
# 设 true 时封面才调 IMAGE_PROVIDER 的 AI 绘画，失败仍回退模板
# COVER_USE_AI=false

# 数据看板配置（可选）
FOLLOWERS_TARGET=1400
FOLLOWERS_CURRENT=900

# 预设评论开关（2026 合规改造，默认关闭）
# 小红书 2026 新规严打 AI 批量评论/模拟真人互动，默认禁用。
# 评论区的互动由 BOSS 亲自手写回复（见 note.md 发布前自查清单）。
# PRESET_COMMENTS_ENABLED=true
